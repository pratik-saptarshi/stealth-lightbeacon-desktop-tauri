{
  "name": "stealth-lightbeacon-desktop-tauri",
  "private": true,
  "version": "0.1.4",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:contract-sync": "python3 scripts/check_contract_sync.py",
    "check": "pnpm run lint && pnpm run test:coverage && pnpm run test:e2e && pnpm run test:python && pnpm run test:rust",
    "lint": "eslint .",
    "eval:node-version": "bash scripts/evals/node-version-gate.sh",
    "eval:node-version:test": "bash scripts/evals/node-version-gate.test.sh",
    "preview": "vite preview",
    "pretest:e2e": "pnpm exec playwright install chromium",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:headed": "pnpm exec playwright test --headed",
    "test:coverage": "vitest run src --coverage",
    "test:coverage:frontend": "vitest run --coverage",
    "icons:sync": "tauri icon public/favicon.svg",
    "tauri:build": "tauri build --bundles app",
    "tauri:dev": "tauri dev",
    "test": "vitest run src",
    "test:python": "node -e \"const{spawnSync}=require('node:child_process');const p=process.platform==='win32'?'python':'python3';const r=spawnSync(p,['-m','unittest','discover','-s','tests/contracts','-p','test_*.py'],{stdio:'inherit'});process.exit(r.status??1)\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "validate:shell": "pnpm run test:coverage:frontend && pnpm run validate:shell:smoke && pnpm run validate:shell:a11y",
    "validate:shell:smoke": "node scripts/browser_smoke.mjs",
    "validate:shell:a11y": "node scripts/validate_shell.mjs --axe",
    "validate:release": "python3 scripts/release_validate.py",
    "release:verify": "pnpm run build && pnpm run test && pnpm run test:python && pnpm run test:rust:unit",
    "test:rust:unit": "cargo test --manifest-path src-tauri/Cargo.toml -- --skip real_backend --skip local_mode_",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
